# ============================================================
# Mẫu cấu hình. Sao chép thành .env rồi chỉnh:  cp .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore).
# ============================================================

# --- Phiên bản image (cả nhóm PHẢI dùng chung để kết quả tái lập được) ---
NGINX_VERSION=1.27-alpine
ALPINE_VERSION=3.20

# Phiên bản OpenZiti: để trống ở Giai đoạn 0-1.
# Giai đoạn 2: cả nhóm cùng chọn MỘT phiên bản cụ thể rồi điền vào đây
# (không dùng "latest" vì nó thay đổi theo thời gian).
ZITI_VERSION=

# --- Lab baseline (Giai đoạn 1) ---
# Cổng trên máy host trỏ vào web baseline (chỉ để bạn mở thử bằng trình duyệt).
WEB_HOST_PORT=8080

# --- Mật khẩu admin Ziti (dùng từ Giai đoạn 2, mỗi người tự đặt) ---
ZITI_PWD=
